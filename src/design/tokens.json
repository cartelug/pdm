{
  "version": "1.0.0",
  "about": "Single source for the Pamodzi design tokens. scripts/tokens.mjs generates src/design/generated/tokens.css from this file and tests/quality/contrast.cjs reads the contrast rules at the bottom. A breaking change to a token name or value bumps the major version and is recorded in the decision log in ARCHITECTURE.md.",
  "breakpoints": {
    "sm": 640,
    "md": 900,
    "lg": 1200
  },
  "fonts": {
    "head": {
      "family": "Archivo",
      "weights": [500, 800],
      "file": "assets/fonts/archivo-latin-wght-normal.woff2",
      "use": "Headings, menus, buttons, labels, figures",
      "package": "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2",
      "fallback": {
        "local": "Arial",
        "sizeAdjust": "102.5%",
        "ascentOverride": "85.7%",
        "descentOverride": "20.5%",
        "lineGapOverride": "0%"
      },
      "tabularFigures": true
    },
    "body": {
      "family": "Lexend",
      "weights": [400, 600],
      "file": "assets/fonts/lexend-latin-wght-normal.woff2",
      "use": "Paragraphs, forms, captions",
      "package": "@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2",
      "fallback": {
        "local": "Arial",
        "sizeAdjust": "110.8%",
        "ascentOverride": "90.2%",
        "descentOverride": "22.6%",
        "lineGapOverride": "0%"
      },
      "tabularFigures": false
    },
    "fallback": "\"Segoe UI\", system-ui, -apple-system, Roboto, Arial, sans-serif",
    "italics": false,
    "about": "Weight-only variable files (no width axis, so type can never look stretched). Archivo has tabular figures; Lexend does not, so money and counts are set in Archivo. Neither font has the arrow glyphs, which fall back to the system font. Fallback faces are tuned to Arial metrics so text does not jump when the fonts arrive."
  },
  "type": {
    "display": "clamp(2.5rem, 1.6rem + 4.2vw, 5rem)",
    "h1": "clamp(2.125rem, 1.5rem + 3vw, 3.75rem)",
    "h2": "clamp(1.75rem, 1.35rem + 1.8vw, 2.75rem)",
    "h3": "clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem)",
    "h4": "1.125rem",
    "lead": "clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem)",
    "body": "clamp(1rem, 0.97rem + 0.15vw, 1.0625rem)",
    "small": "0.875rem",
    "caption": "0.8125rem",
    "figure": "clamp(2rem, 1.5rem + 2.4vw, 3.5rem)",
    "measure": "60ch"
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "9": 96,
    "10": 128
  },
  "layout": {
    "gutter": "clamp(16px, 4vw, 56px)",
    "shell": "1240px",
    "section": "clamp(64px, 8vw, 128px)"
  },
  "radius": {
    "s": "8px",
    "m": "16px",
    "l": "24px",
    "pill": "999px",
    "arch": "999px 999px 0 0"
  },
  "layers": {
    "raised": 10,
    "sticky": 40,
    "header": 50,
    "overlay": 70,
    "modal": 80,
    "toast": 90
  },
  "motion": {
    "duration": {
      "press": "120ms",
      "hover": "180ms",
      "ui": "240ms",
      "panel": "420ms",
      "reveal": "640ms"
    },
    "ease": {
      "out": "cubic-bezier(0.2, 0.7, 0.2, 1)",
      "inout": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  },
