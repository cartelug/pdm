{
  "title": "Contact",
  "heading": "Let's build<br><em>something.</em>",
  "description": "Contact Pamodzi Community Initiative about partnerships, project ideas, technical support, media or general enquiries.",
  "html": "\n\n<section class=\"blk\">\n  <div class=\"wrap\">\n    <h2 class=\"sr-only\">Contact options</h2>\n    <div class=\"cards reveal\">\n      <a class=\"card\" href=\"https://wa.me/256708735878\" target=\"_blank\" rel=\"noopener\">\n        <span class=\"n\">CONTACT</span><h3>WhatsApp</h3>\n        <p>+256 708 735 878 — message the team directly.</p>\n      </a>\n      <a class=\"card\" href=\"mailto:shyakaneeza@gmail.com\">\n        <span class=\"n\">CONTACT</span><h3>Email</h3>\n        <p>shyakaneeza@gmail.com — send a message or document.</p>\n      </a>\n      <a class=\"card\" href=\"../faith-in-motion/index.html\">\n        <span class=\"n\">GIVING</span><h3>Faith in Motion</h3>\n        <p>Sponsor a step in the live campaign for St Joseph Catholic Church, Rwembyo.</p>\n      </a>\n      <a class=\"card\" href=\"../walk-for-education/take-part/index.html\">\n        <span class=\"n\">CAMPAIGN</span><h3>Walk for Education</h3>\n        <p>Choose the public, Rotary or institutional route for the 2026 education campaign.</p>\n      </a>\n    </div>\n  </div>\n</section>\n\n<section class=\"blk on-dark\">\n  <div class=\"wrap grid\">\n    <div class=\"c-main reveal\">\n      <span class=\"eyebrow on-dark\">Send a message</span>\n      <h2>Tell us where you fit.</h2>\n      <p class=\"lede\">A sentence or two is plenty. This opens your email app with the message ready to send.</p>\n\n      <form class=\"form\" id=\"enquiryForm\">\n        <div class=\"frow\">\n          <div><label for=\"iName\">Your name</label><input id=\"iName\" name=\"name\" type=\"text\" autocomplete=\"name\" placeholder=\"Full name\" required></div>\n          <div><label for=\"iContact\">Email or phone</label><input id=\"iContact\" name=\"contact\" type=\"text\" autocomplete=\"email\" placeholder=\"How we reach you\" required></div>\n        </div>\n        <div class=\"frow\">\n          <div><label for=\"iTopic\">Area of interest</label>\n            <select id=\"iTopic\" name=\"topic\">\n              <option>General enquiry</option>\n              <option>Education</option>\n              <option>Health</option>\n              <option>Climate &amp; green development</option>\n              <option>Financial inclusion &amp; enterprise</option>\n              <option>Walk for Education — sponsor steps</option>\n              <option>Walk for Education — Rotary club participation</option>\n              <option>Walk for Education — institution / company</option>\n              <option>Faith in Motion campaign</option>\n              <option>Organisational support</option>\n            </select></div>\n          <div><label for=\"iType\">You are</label>\n            <select id=\"iType\" name=\"enquirerType\">\n              <option>A government institution</option>\n              <option>A development or financing partner</option>\n              <option>A business or CSR programme</option>\n              <option>A financial institution or funder</option>\n              <option>A community organisation or group</option>\n              <option>Proposing a project</option>\n              <option>Press or media</option>\n              <option>Something else</option>\n            </select></div>\n        </div>\n        <div><label for=\"iMsg\">Your message</label><textarea id=\"iMsg\" name=\"message\" rows=\"4\" placeholder=\"A sentence or two is plenty.\"></textarea></div>\n        <div><button class=\"btn btn-gold\" id=\"send\" type=\"submit\">Send enquiry</button></div>\n      </form>\n    </div>\n    <div class=\"c-side reveal\">\n      <div class=\"figs\">\n        <div class=\"fig\"><b class=\"mono\">Uganda</b><span>Community development focus</span></div>\n        <div class=\"fig\"><b class=\"mono\">Local</b><span>Priorities defined with communities</span></div>\n      </div>\n      <div class=\"notice\">\n        <b>On contributions.</b> Request the current approved transfer instructions and beneficiary name for the relevant campaign, verify both before sending, and never treat an enquiry contact as a payment channel.\n      </div>\n    </div>\n  </div>\n</section>\n\n",
  "owner": "Pamodzi Community Initiative",
  "source": "contact/index.html at 15e13113ca838bfec2b193d6a52f6cedca7f61bb",
  "publication": "existing-public",
  "reviewedAt": null
}
