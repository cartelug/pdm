---
import { asset } from "../../config/site";
import collection from "../../../assets/wfe-2026/official-kit/manifest.json";
import refreshed from "../../../assets/wfe-2026/refresh/manifest.json";
import replacements from "../../../assets/wfe-2026/refresh/scene-map.json";
interface Props {
  scene: string;
  from?: string;
  alt?: string;
  eager?: boolean;
  // Use the tall composition at every screen size, for a portrait frame beside copy.
  portrait?: boolean;
}
const { scene, from = "/", alt = "", eager = false, portrait = false } = Astro.props;
const original = collection.scenes.find((item) => item.id === scene);
if (!original) throw new Error(`Unknown campaign scene ${scene}`);
const mapping = replacements[scene as keyof typeof replacements];
const imageFor = (orientation: string) => {
  const id = mapping?.[orientation as "desktop" | "mobile"];
  return refreshed.records.find((item) => item.id === id);
};
const record = mapping ? { compositions: { desktop: imageFor("desktop")!, mobile: imageFor("mobile")! } } : original;
const imageAlt = alt && mapping ? imageFor(portrait ? "mobile" : "desktop")!.alt : alt;
const base = `assets/wfe-2026/official-kit/scene-${scene}`;
const src = (suffix: string) => {
  const [orientation, size] = suffix.split("-");
  const image = imageFor(orientation);
  return asset(from, image ? `assets/wfe-2026/refresh/${image.id}-${size}` : `${base}-${suffix}`);
};
const set = (orientation: string, format: string, widths: number[]) =>
  widths
    .map(
      (width) =>
        `${src(`${orientation}-${width}.${format}`)} ${Math.min(width, record.compositions[orientation as "desktop" | "mobile"].width)}w`,
    )
    .join(", ");
---

{portrait ? (
  <picture data-campaign-scene={scene}>
    <source
      type="image/avif"
      srcset={set("mobile", "avif", [480, 800])}
      sizes="(max-width: 959px) 90vw, 560px"
      width={record.compositions.mobile.width}
      height={record.compositions.mobile.height}
    />
    <img
      src={src("mobile-800.webp")}
      srcset={set("mobile", "webp", [480, 800])}
      sizes="(max-width: 959px) 90vw, 560px"
      width={record.compositions.mobile.width}
      height={record.compositions.mobile.height}
      alt={imageAlt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </picture>
) : (
  <picture data-campaign-scene={scene}>
    <source
      media="(max-width: 719px)"
      type="image/avif"
      srcset={set("mobile", "avif", [480, 800])}
      sizes="100vw"
      width={record.compositions.mobile.width}
      height={record.compositions.mobile.height}
    />
    <source
      media="(max-width: 719px)"
      srcset={set("mobile", "webp", [480, 800])}
      sizes="100vw"
      width={record.compositions.mobile.width}
      height={record.compositions.mobile.height}
    />
    <source type="image/avif" srcset={set("desktop", "avif", [800, 1440])} sizes="100vw" />
    <img
      src={src("desktop-1440.webp")}
      srcset={set("desktop", "webp", [800, 1440])}
      sizes="100vw"
      width={record.compositions.desktop.width}
      height={record.compositions.desktop.height}
      alt={imageAlt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
    />
  </picture>
)}
