---
interface Props {
  name: "education" | "health" | "climate" | "inclusion";
}
const { name } = Astro.props;
const shapes = {
  education: [
    "M24 15c-4.2-3.2-11-4.2-17-2.2v23c6-2 12.8-1 17 2.2",
    "M24 15c4.2-3.2 11-4.2 17-2.2v23c-6-2-12.8-1-17 2.2",
    "M24 15v23",
  ],
  health: ["M24 40S8 30.4 8 19.2a8.6 8.6 0 0 1 16-4.3 8.6 8.6 0 0 1 16 4.3C40 30.4 24 40 24 40Z", "M24 19v10M19 24h10"],
  climate: ["M10 38C9 21 20 10 39 9c1 18-9 29-26 29", "M10 38 29 19"],
  inclusion: ["M19 21.5a8.5 8.5 0 1 0 0-.01Z", "M31 21.5a8.5 8.5 0 1 0 0-.01Z", "M25 31.5a8.5 8.5 0 1 0 0-.01Z"],
};
---

<svg class="pci-pillar-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
  {shapes[name].map((d) => (
    <path {d} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  ))}
</svg>
