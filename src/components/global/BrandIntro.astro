---
import { primaryNav } from "../../config/navigation";
import { asset } from "../../config/site";
interface Props {
  path: string;
  title: string;
  home?: boolean;
}
const { path, title, home = false } = Astro.props;

// The intro names the page with words the site already uses: its navigation section and its own title.
const section = (() => {
  if (home) return "Pamodzi Community Initiative";
  if (path.startsWith("/updates/")) return "Updates";
  if (path === "/contact/") return "Contact";
  if (path === "/design-system/") return "Design system";
  if (["/community/", "/apartments/"].includes(path)) return "Our work";
  const group = primaryNav.find((entry) => entry.route === path || entry.items?.some((item) => item.route === path));
  return group?.label ?? "Pamodzi Community Initiative";
})();
---

<!--
  Brand intro. A short, fixed-length opening on every institutional page: it never waits for loading, never
  takes clicks (pointer-events: none), is hidden from assistive technology, and any key, click, scroll or touch
  dismisses it at once. CSS alone plays and ends it, so it also finishes if scripts fail. Reduced motion and
  back/forward navigation skip it. The logo is the approved runtime copy; only its container is animated.
-->
<script is:inline>
  (() => {
    const root = document.documentElement;
    try {
      const nav = performance.getEntriesByType("navigation")[0];
      if (nav && nav.type === "back_forward") return root.classList.add("pci-intro-off");
      // The full opening plays once per visit; later pages get the short version.
      if (sessionStorage.getItem("pci-intro")) root.classList.add("pci-intro-short");
      sessionStorage.setItem("pci-intro", "1");
    } catch {
      root.classList.add("pci-intro-short");
    }
  })();
</script>
<div class="pci-intro" aria-hidden="true">
  <span class="pci-intro__veil"></span>
  <div class="pci-intro__panel">
    <div class="pci-intro__stage">
      <svg class="pci-intro__orbit" viewBox="0 0 200 200" focusable="false">
        <circle class="pci-intro__ring" cx="100" cy="100" r="94" pathLength="1"></circle>
        <circle class="pci-intro__ring pci-intro__ring--blue" cx="100" cy="100" r="86" pathLength="1"></circle>
        <g class="pci-intro__traveller">
          <circle cx="100" cy="6" r="4.5"></circle>
        </g>
      </svg>
      <span class="pci-intro__mark">
        <img
          src={asset(path, "assets/brand/pamodzi/pamodzi-logo-320.webp")}
          srcset={`${asset(path, "assets/brand/pamodzi/pamodzi-logo-160.webp")} 160w, ${asset(path, "assets/brand/pamodzi/pamodzi-logo-320.webp")} 320w`}
          sizes="(max-width: 639px) 112px, 148px"
          width="320"
          height="243"
          alt=""
          decoding="async"
        />
      </span>
    </div>
    <p class="pci-intro__label">
      <span>{section}</span>
    </p>
    <p class="pci-intro__title">
      <span>{title}</span>
    </p>
    <span class="pci-intro__thread"></span>
  </div>
</div>
