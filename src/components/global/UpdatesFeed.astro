---
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";
import { href } from "../../config/site";
interface Props {
  path: string;
  limit?: number;
}
const { path, limit = 3 } = Astro.props;
const entries = (await getCollection("updates", (u) => u.data.publication === "approved"))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, limit);
---

{entries.length ? (
  <div class="pci-cards">
    {entries.map((entry) => (
      <a class="pci-card pci-card--link" href={href(path, "/updates/" + entry.id + "/")} data-reveal>
        <span class="pci-card__label">
          {entry.data.category} · {entry.data.date}
        </span>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.summary}</p>
        <Icon name="external" />
      </a>
    ))}
  </div>
) : (
  <div class="pci-empty-state" data-reveal>
    <h3>Institutional stories are awaiting publication review.</h3>
    <div>
      <p>
        For current campaign progress and contribution guidance, visit the dedicated campaign records. Dates, figures
        and permissions are checked before new institutional stories appear here.
      </p>
      <div class="pci-actions">
        <a class="pci-text-link" href={href(path, "/walk/")}>
          Faith in Motion Journey <Icon name="external" />
        </a>
        <a class="pci-text-link" href={href(path, "/walk-for-education/updates/")}>
          Education Campaign Updates <Icon name="external" />
        </a>
      </div>
    </div>
  </div>
)}
