---
import Icon from "./Icon.astro";
import { navigation, primaryNav, isCurrent } from "../../config/navigation";
import { asset, href } from "../../config/site";
import { campaignView } from "../../lib/campaign";
interface Props {
  path: string;
  home?: boolean;
}
const { path, home = false } = Astro.props;
const walk = campaignView();
const labelFor = (route: string) => navigation.find((n) => n.route === route)?.label ?? route;
// Groups with several pages keep a heading in the phone menu; single pages follow as plain rows.
const grouped = primaryNav.filter((g) => g.items);
const singles = primaryNav.filter((g) => !g.items);
let rowIndex = 0;
---

<header class:list={["pci-header", { "pci-header--home": home }]} data-site-header>
  <div class="pci-container pci-header__inner">
    <a class="pci-brand" href={href(path, "/")} aria-label="Pamodzi Community Initiative home">
      <span class="pci-brand__mark">
        <img src={asset(path, "assets/brand/pamodzi/pamodzi-logo-160.webp")} width="160" height="121" alt="" />
      </span>
      <span class="pci-brand__text">
        <span class="pci-brand__name">Pamodzi</span>
        <small>Community Initiative</small>
      </span>
    </a>
    <nav class="pci-desktop-nav" aria-label="Primary navigation">
      <ul>
        {primaryNav.map((group) => (
          <li class:list={["pci-nav-item", { "has-sub": group.items }]}>
            <a href={href(path, group.route)} aria-current={isCurrent(group, path) ? "page" : undefined}>
              {group.label}
            </a>
            {group.items && (
              <ul class="pci-dropdown">
                {group.items.map((item) => (
                  <li>
                    <a href={href(path, item.route)} aria-current={path === item.route ? "page" : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    {walk.live && (
      <a class="pci-campaign-chip" href={href(path, "/walk-for-education/")} data-protected>
        <span class="pci-campaign-chip__name">Walk for Education</span>
        <span class="pci-campaign-chip__status">{walk.label}</span>
      </a>
    )}
    <a class="pci-button pci-button--ink pci-header__cta" href={href(path, "/contact/")}>
      Contact <Icon name="arrow" />
    </a>
    <button
      class="pci-menu-toggle"
      type="button"
      aria-controls="pciNavigation"
      aria-expanded="false"
      aria-label="Open navigation"
      data-menu-open
      hidden
    >
      Menu <Icon name="menu" />
    </button>
  </div>
  <details class="pci-fallback-nav" data-nav-fallback>
    <summary>Explore the website</summary>
    <nav class="pci-nojs-nav" aria-label="All pages">
      {navigation.map((n) => (
        <a href={href(path, n.route)}>{n.label}</a>
      ))}
    </nav>
  </details>
</header>
<dialog class="pci-menu" id="pciNavigation" aria-labelledby="pciMenuTitle" data-menu>
  <div class="pci-menu__top">
    <a class="pci-menu__identity" href={href(path, "/")}>
      Pamodzi <span>Community Initiative</span>
    </a>
    <button class="pci-menu__close" type="button" aria-label="Close navigation" data-menu-close>
      Close <Icon name="close" />
    </button>
  </div>
  <div class="pci-menu__body">
    <h2 class="pci-eyebrow" id="pciMenuTitle">
      Explore Pamodzi
    </h2>
    <nav aria-label="Mobile primary navigation">
      {grouped.map((group) => (
        <section class="pci-menu__group">
          <h3 class="pci-eyebrow">{group.label}</h3>
          <ol class="pci-menu__links">
            {group.items!.map((item) => (
              <li style={"--i:" + rowIndex++}>
                <a href={href(path, item.route)} aria-current={path === item.route ? "page" : undefined}>
                  <span class="pci-menu__index">{String(rowIndex).padStart(2, "0")}</span>
                  <span>{labelFor(item.route)}</span>
                  <span aria-hidden="true">
                    <Icon name="external" />
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
      <ol class="pci-menu__links">
        {singles.map((group) => (
          <li style={"--i:" + rowIndex++}>
            <a href={href(path, group.route)} aria-current={path === group.route ? "page" : undefined}>
              <span class="pci-menu__index">{String(rowIndex).padStart(2, "0")}</span>
              <span>{labelFor(group.route)}</span>
              <span aria-hidden="true">
                <Icon name="external" />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="pci-menu__utilities">
      {(["engage"] as const).map((group, groupIndex) => (
        <nav aria-label="Campaigns and contact" style={"--i:" + (rowIndex + groupIndex)}>
          <h3 class="pci-eyebrow">Campaigns and contact</h3>
          {navigation
            .filter((n) => n.group === group)
            .map((n) => (
              <a href={href(path, n.route)} data-protected={n.protected || undefined}>
                {n.label}
                <span aria-hidden="true">
                  <Icon name="external" />
                </span>
              </a>
            ))}
        </nav>
      ))}
    </div>
    <a class="pci-button pci-button--light" href={href(path, "/contact/#enquiry")}>
      Partner With Pamodzi <Icon name="arrow" />
    </a>
    <p class="pci-menu__note">People. Partnerships. Lasting change.</p>
  </div>
</dialog>
<script>
  // Escape closes an open submenu until the pointer or focus leaves its item (WCAG 1.4.13).
  document.querySelectorAll<HTMLElement>(".pci-nav-item.has-sub").forEach((item) => {
    const clear = () => item.removeAttribute("data-dismissed");
    item.addEventListener("mouseleave", clear);
    item.addEventListener("focusout", (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) clear();
    });
    item.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      item.setAttribute("data-dismissed", "");
      item.querySelector<HTMLElement>(":scope > a")?.focus();
    });
  });
</script>
