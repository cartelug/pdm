---
interface Props {
  name?: "arrow" | "external" | "down" | "menu" | "close";
}
const { name = "external" } = Astro.props;
const paths = {
  arrow: "M4 12h15m-6-6 6 6-6 6",
  external: "M6 18 18 6M6 6h12v12",
  down: "M12 4v15m-6-6 6 6 6-6",
  menu: "M3 7h18M9 17h12",
  close: "m6 6 12 12M6 18 18 6",
};
---

<svg class="pci-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <path d={paths[name]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
