---
import Icon from "./Icon.astro";
interface Item {
  label: string;
  title: string;
  text: string;
  to?: string;
  external?: boolean;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="pci-cards" data-reveal-group>
  {items.map((item) =>
    item.to ? (
      <a
        class="pci-card pci-card--link"
        href={item.to}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener noreferrer" : undefined}
      >
        <span class="pci-card__label">{item.label}</span>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        <Icon name="external" />
      </a>
    ) : (
      <article class="pci-card">
        <span class="pci-card__label">{item.label}</span>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </article>
    ),
  )}
</div>
