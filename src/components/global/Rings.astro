---
// Decorative "together" motif: overlapping rings. Always hidden from assistive technology.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg class={className} viewBox="0 0 1000 1000" aria-hidden="true" focusable="false">
  <circle cx="500" cy="500" r="480"></circle>
  <circle cx="500" cy="500" r="400"></circle>
  <circle cx="500" cy="500" r="320"></circle>
  <circle cx="500" cy="500" r="240"></circle>
  <circle cx="500" cy="500" r="160"></circle>
  <circle cx="500" cy="500" r="80"></circle>
</svg>
