---
interface Props {
  eyebrow: string;
  lede?: string;
  id?: string;
}
const { eyebrow, lede, id } = Astro.props;
---

<div class="pci-section-head" data-reveal>
  <div>
    <span class="pci-eyebrow">{eyebrow}</span>
    <h2 id={id}>
      <slot />
    </h2>
  </div>
  {lede && <p class="pci-lead">{lede}</p>}
</div>
