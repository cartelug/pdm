---
import Icon from "../global/Icon.astro";
import { modelStages, modelSummaries } from "../../config/navigation";
import { href } from "../../config/site";
interface Props {
  path: string;
  full?: boolean;
}
const { path, full = false } = Astro.props;
---

<section class="pci-section pci-dark" id="iciadm">
  <div class="pci-container">
    <div class="pci-section-heading">
      <div>
        <span class="pci-eyebrow">{full ? "The ICIADM pathway" : "03 / How we work"}</span>
        <h2>
          Local resources.
          <br />
          Collective action.
          <br />
          <em>Lasting development.</em>
        </h2>
      </div>
      <p class="pci-lead">
        Our Integrated Community Investment and Asset Development Model organises local resources around shared
        priorities, with clear governance for the assets and income the work may create.
      </p>
    </div>
    <div class="pci-model-path" data-model-path>
      <svg
        class="pci-model-path__line"
        viewBox="0 0 4 1000"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path class="pci-model-path__base" d="M2 0V1000" stroke="currentColor" stroke-width="2" />
        <path d="M2 0V1000" stroke="currentColor" stroke-width="2" pathLength="1" data-model-progress />
      </svg>
      <ol class="pci-model" data-model>
        {modelStages.map((stage, i) => (
          <li id={"stage-" + (i + 1)}>
            <a href={"#stage-" + (i + 1)} data-model-stage>
              <span>{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{stage}</h3>
                <span class="pci-model__summary">{modelSummaries[i]}</span>
              </div>
              <span class="pci-model__arrow" aria-hidden="true">
                <Icon name="external" />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <p class="pci-model__note">
      Each stage feeds the next. Income generated by an asset is reinvested, so the cycle strengthens rather than ends.
      The full model explains the approach and its governance.
    </p>
    <a class="pci-text-link" href={href(path, "/model/")}>
      Explore The Full Model <Icon name="external" />
    </a>
  </div>
</section>
