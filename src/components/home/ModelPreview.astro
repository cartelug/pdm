---
import Icon from "../global/Icon.astro";
import { modelStages, modelSummaries } from "../../config/navigation";
import { href } from "../../config/site";
interface Props {
  path: string;
  full?: boolean;
}
const { path, full = false } = Astro.props;
// Nine stages sit on one ring; the last feeds the first, so the model reads as a cycle rather than a line.
const centre = 200;
const radius = 150;
const nodes = modelStages.map((_, i) => {
  const angle = ((-90 + (i * 360) / modelStages.length) * Math.PI) / 180;
  return { x: +(centre + radius * Math.cos(angle)).toFixed(2), y: +(centre + radius * Math.sin(angle)).toFixed(2) };
});
---

<section class="pci-section pci-section--night" id="iciadm" data-model-path>
  <div class="pci-container">
    <div class="pci-section-head" data-reveal>
      <div>
        <span class="pci-eyebrow">{full ? "The ICIADM pathway" : "03 / How we work"}</span>
        <h2>
          Local resources.
          <br />
          Collective action.
          <br />
          <em>Lasting development.</em>
        </h2>
      </div>
      <p class="pci-lead">
        Our Integrated Community Investment and Asset Development Model organises local resources around shared
        priorities, with clear governance for the assets and income the work may create.
      </p>
    </div>
    <div class="pci-model-layout">
      <div class="pci-cycle" aria-hidden="true">
        <svg viewBox="0 0 400 400" focusable="false">
          <circle class="pci-cycle__track" cx={centre} cy={centre} r={radius}></circle>
          <circle
            class="pci-cycle__progress"
            cx={centre}
            cy={centre}
            r={radius}
            transform={`rotate(-90 ${centre} ${centre})`}
            pathLength="1"
            stroke-dasharray="1"
            data-model-progress
          ></circle>
          {nodes.map((node, i) => (
            <g class="pci-cycle__node" data-cycle-node={i + 1}>
              <circle cx={node.x} cy={node.y} r="17"></circle>
              <text x={node.x} y={node.y}>
                {String(i + 1).padStart(2, "0")}
              </text>
            </g>
          ))}
          <text class="pci-cycle__title" x={centre} y={centre + 14}>
            ICIADM
          </text>
          <text class="pci-cycle__sub" x={centre} y={centre + 42}>
            Each stage feeds the next
          </text>
        </svg>
      </div>
      <ol class="pci-model" data-model>
        {modelStages.map((stage, i) => (
          <li id={"stage-" + (i + 1)}>
            <a href={"#stage-" + (i + 1)} data-model-stage={i + 1}>
              <span>{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{stage}</h3>
                <span class="pci-model__summary">{modelSummaries[i]}</span>
              </div>
              <span class="pci-model__arrow" aria-hidden="true">
                <Icon name="external" />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <p class="pci-model__note">
      Each stage feeds the next. Income generated by an asset is reinvested, so the cycle strengthens rather than ends.
      {!full && " The full model explains the approach and its governance."}
    </p>
    {!full && (
      <a class="pci-text-link" href={href(path, "/model/")}>
        Explore The Full Model <Icon name="external" />
      </a>
    )}
  </div>
</section>
