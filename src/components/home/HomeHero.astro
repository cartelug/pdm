---
import Icon from "../global/Icon.astro";
import ScenePicture from "../global/ScenePicture.astro";
import { campaignView } from "../../lib/campaign";
const walk = campaignView();
---

<section class="pci-hero" id="top" aria-labelledby="home-heading">
  <div class="pci-hero__media" aria-hidden="true">
    <ScenePicture scene="01" eager />
  </div>
  <div class="pci-hero__shade" aria-hidden="true"></div>
  <div class="pci-container pci-hero__layout">
    <div class="pci-hero__copy">
      <span class="pci-eyebrow" data-hero-detail>
        Community-led development · Uganda
      </span>
      <h1 id="home-heading" aria-label="Together, we build what lasts.">
        <span class="pci-hero__line">
          <span>Together, we build</span>
        </span>
        <span class="pci-hero__line">
          <span>
            <em>what lasts.</em>
          </span>
        </span>
      </h1>
      <p class="pci-hero__intro" data-hero-detail>
        Local resources. Shared purpose. Lasting development.
      </p>
      <p class="pci-hero__description" data-hero-detail>
        Pamodzi brings communities and partners together around the priorities people define for themselves.
      </p>
      <div class="pci-actions" data-hero-detail>
        <a class="pci-button pci-button--light" href="projects/index.html">
          Explore Our Work <Icon name="arrow" />
        </a>
        <a class="pci-text-link" href="model/index.html">
          Our approach <Icon />
        </a>
      </div>
    </div>
    <aside class="pci-hero__live" aria-label="Current campaigns">
      <a class="pci-live" href="walk-for-education/index.html" data-protected>
        <span class="pci-live__status">{walk.label}</span>
        <strong>Walk for Education</strong>
        <span class="pci-live__go" aria-hidden="true">
          <Icon name="external" />
        </span>
      </a>
      <a class="pci-live" href="faith-in-motion/index.html">
        <span class="pci-live__status">Journey completed · fundraising continues</span>
        <strong>Faith in Motion</strong>
        <span class="pci-live__go" aria-hidden="true">
          <Icon name="external" />
        </span>
      </a>
    </aside>
  </div>
  <p class="pci-hero__caption">Campaign illustration · the walk for education</p>
</section>
<div class="pci-strip" aria-label="How Pamodzi works">
  <div class="pci-container">
    <ul>
      <li>
        <span>01</span>Locally defined
      </li>
      <li>
        <span>02</span>Member-led
      </li>
      <li>
        <span>03</span>Partnership-based
      </li>
      <li>
        <span>04</span>Accountable
      </li>
    </ul>
  </div>
</div>
