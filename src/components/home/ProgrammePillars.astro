---
import { programmes } from "../../config/navigation";
import Icon from "../global/Icon.astro";

// One satin ribbon sculpture per pillar, drawn in that pillar's colour (assets/pillars).
const art = (id: string) => `assets/pillars/sculpture-${id}`;
---

<section class="pci-section pci-pillars-section" id="our-pillars" aria-labelledby="pillars-heading">
  <div class="pci-container">
    <div class="pci-section-head" data-reveal>
      <div>
        <span class="pci-eyebrow">01 / Our four pillars</span>
        <h2 id="pillars-heading">
          One community.
          <br />
          <em>Many possibilities.</em>
        </h2>
      </div>
      <p class="pci-lead">
        Education. Health. A greener future. Financial inclusion. Four areas of work, shaped by the people they serve.
      </p>
    </div>
    <div class="pci-pillars" data-pillars data-active="education">
      <div class="pci-pillars__stage">
        <span class="pci-pillars__halo" aria-hidden="true"></span>
        <span class="pci-pillars__ring" aria-hidden="true"></span>
        <div class="pci-pillars__art" aria-hidden="true">
          {programmes.map((p) => (
            <picture class="pci-pillars__sculpture" data-for={p.id}>
              <source type="image/avif" srcset={`${art(p.id)}.avif`} />
              <img src={`${art(p.id)}.webp`} width="480" height="480" alt="" loading="lazy" decoding="async" />
            </picture>
          ))}
          <span class="pci-pillars__floor"></span>
        </div>
        <div class="pci-pillars__tabs" role="tablist" aria-label="Our four pillars">
          {programmes.map((p, i) => (
            <button
              type="button"
              role="tab"
              class="pci-pillar"
              id={`pillar-tab-${p.id}`}
              aria-controls={`pillar-panel-${p.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-pillar={p.id}
              style={`--i:${i}`}
            >
              <span class="pci-pillar__coin">
                <picture>
                  <source type="image/avif" srcset={`${art(p.id)}.avif`} />
                  <img src={`${art(p.id)}.webp`} width="480" height="480" alt="" loading="lazy" decoding="async" />
                </picture>
              </span>
              <span class="pci-pillar__label">{p.short}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="pci-pillars__panels" data-pillars-panels>
        {programmes.map((p) => (
          <article
            class="pci-pillars__panel"
            role="tabpanel"
            id={`pillar-panel-${p.id}`}
            aria-labelledby={`pillar-tab-${p.id}`}
            data-pillar={p.id}
          >
            <h3>{p.title}</h3>
            <p class="pci-pillars__summary">{p.summary}</p>
            <ul class="pci-pillars__covers">
              {p.covers.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
            <a class="pci-pillars__go" href={"what-we-do/index.html#" + p.id}>
              {p.cta}
              <span aria-hidden="true">
                <Icon />
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
    <p class="pci-art-note">
      Sculptures are artwork for our programme areas. Project records identify the work and its current status.
    </p>
  </div>
</section>

<script>
  import { initPillars } from "../../scripts/pillars";

  document.querySelectorAll<HTMLElement>("[data-pillars]").forEach(initPillars);
</script>
