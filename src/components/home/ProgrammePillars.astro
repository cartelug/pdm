---
import { programmes } from "../../config/navigation";
import Icon from "../global/Icon.astro";
import PillarIcon from "../global/PillarIcon.astro";
const artwork = ["education", "health", "climate", "inclusion"] as const;
---

<section class="pci-section" id="our-pillars" aria-labelledby="pillars-heading">
  <div class="pci-container">
    <div class="pci-section-head" data-reveal>
      <div>
        <span class="pci-eyebrow">01 / Our four pillars</span>
        <h2 id="pillars-heading">
          One community.
          <br />
          <em>Many possibilities.</em>
        </h2>
      </div>
      <p class="pci-lead">
        Education. Health. A greener future. Financial inclusion. Four areas of work, shaped by the people they serve.
      </p>
    </div>
    <div class="pci-pillars" data-reveal>
      {programmes.map((p, i) => (
        <a class="pci-pillar" href={"what-we-do/index.html#" + p.id} data-pillar={artwork[i]}>
          <div class="pci-pillar__art" aria-hidden="true">
            <img
              src={"assets/crimson/pillar-" + artwork[i] + "-480.webp"}
              width="480"
              height="480"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="pci-pillar__rail" aria-hidden="true" data-title={p.title}>
            <span class="pci-pillar__index">0{i + 1}</span>
            <PillarIcon name={artwork[i]} />
          </span>
          <div class="pci-pillar__body">
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
          </div>
          <span class="pci-pillar__go" aria-hidden="true">
            <Icon />
          </span>
        </a>
      ))}
    </div>
    <p class="pci-art-note">
      Hero imagery illustrates our programme areas. Project records identify the work and its current status.
    </p>
  </div>
</section>
