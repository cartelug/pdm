---
import Icon from "../components/global/Icon.astro";
import ScenePicture from "../components/global/ScenePicture.astro";
import Rings from "../components/global/Rings.astro";
import Layout from "../layouts/InstitutionalLayout.astro";
import UpdatesFeed from "../components/global/UpdatesFeed.astro";
import ModelPreview from "../components/home/ModelPreview.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ProgrammePillars from "../components/home/ProgrammePillars.astro";
import { campaignView } from "../lib/campaign";
import { getProjects } from "../lib/projects";
const records = await getProjects();
const walk = campaignView();
const projects = ["walk-for-education", "faith-in-motion", "community", "kagando"].map((id) =>
  records.find((p) => p.id === id)!,
);
---

<Layout
  path="/"
  title="Together for Development"
  description="Pamodzi brings communities and partners together around locally defined development priorities in Uganda."
  home
>
  <HomeHero />
  <ProgrammePillars />
  <section class="pci-section pci-section--bone pci-manifesto" id="who-we-are">
    <div class="pci-container">
      <div data-reveal>
        <span class="pci-eyebrow">02 / Who we are</span>
        <h2 class="pci-manifesto__title">
          Not a donor.
          <em>A convener.</em>
        </h2>
      </div>
      <p class="pci-manifesto__text" data-scrub-words>
        Sustainable development is strongest when communities help shape, resource and steward their own future.
      </p>
      <div class="pci-manifesto__grid">
        <ol class="pci-trio" data-reveal>
          <li>
            <span>01</span>Convene
          </li>
          <li>
            <span>02</span>Mobilise
          </li>
          <li>
            <span>03</span>Sustain
          </li>
        </ol>
        <div class="pci-manifesto__aside pci-body" data-reveal>
          <figure class="pci-about__art" aria-hidden="true">
            <img
              src="assets/crimson/connection-720.webp"
              width="720"
              height="720"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </figure>
          <p>
            We start with the resources and relationships a community already has — savings groups, cooperatives,
            professionals, businesses, diaspora and local leadership — then organise them around a clear, locally chosen
            priority.
          </p>
          <a class="pci-text-link" href="about/index.html">
            Meet Pamodzi <Icon name="external" />
          </a>
        </div>
      </div>
    </div>
  </section>
  <ModelPreview path="/" />
  <section class="pci-section pci-projects" id="projects">
    <div class="pci-container">
      <div class="pci-section-head" data-reveal>
        <div>
          <span class="pci-eyebrow">04 / Projects & priorities</span>
          <h2>
            Different priorities.
            <br />
            <em>A common purpose.</em>
          </h2>
        </div>
        <p class="pci-lead">
          Explore live campaigns, work under review and community programme areas. Each follows its own approved
          pathway.
        </p>
      </div>
    </div>
    <div class="pci-carousel" data-carousel>
      <div class="pci-carousel__track" role="region" aria-label="Featured projects" tabindex="0" data-carousel-track>
        {projects.map((project) => (
          <ProjectCard {project} path="/" />
        ))}
      </div>
      <div class="pci-container pci-carousel__bar">
        <div class="pci-carousel__progress" aria-hidden="true">
          <span data-carousel-progress></span>
        </div>
        <div class="pci-carousel__buttons">
          <button type="button" class="pci-carousel__button" data-carousel-prev aria-label="Previous projects" hidden>
            <Icon name="arrow" />
          </button>
          <button type="button" class="pci-carousel__button" data-carousel-next aria-label="Next projects" hidden>
            <Icon name="arrow" />
          </button>
        </div>
        <a class="pci-text-link" href="projects/index.html">
          Explore All Projects <Icon name="external" />
        </a>
      </div>
    </div>
  </section>
  <section class="pci-section pci-section--bone pci-practice">
    <div class="pci-practice__backdrop" aria-hidden="true">
      <ScenePicture scene="07" />
      <span class="pci-practice__caption">Campaign illustration · learning together</span>
    </div>
    <div class="pci-container">
      <div class="pci-section-head" data-reveal>
        <div>
          <span class="pci-eyebrow">05 / Work in practice</span>
          <h2>
            Local priorities.
            <br />
            <em>Practical action.</em>
          </h2>
        </div>
        <p class="pci-lead">
          Member-led mutual support, community initiatives and partnerships across livelihoods, education, health and
          local infrastructure.
        </p>
      </div>
      <div class="pci-columns" data-reveal-group>
        {[
          ["Mutual support", "Members responding to practical household, education, medical and livelihood needs."],
          ["Enterprise & livelihoods", "Community savings, financial literacy, skills and locally led opportunity."],
          [
            "Community infrastructure",
            "Defined education, faith and community priorities with project-specific responsibilities.",
          ],
          [
            "Health & wellbeing",
            "Community participation and collaboration with qualified professionals and public bodies.",
          ],
        ].map(([title, copy], i) => (
          <article class="pci-column">
            <span>0{i + 1}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
      <div class="pci-actions">
        <a class="pci-text-link" href="impact/index.html">
          Explore Our Impact <Icon name="external" />
        </a>
      </div>
    </div>
  </section>
  <section class="pci-section pci-section--night pci-duo-section">
    <div class="pci-container">
      <div class="pci-section-head" data-reveal>
        <div>
          <span class="pci-eyebrow">06 / Walking for Impact</span>
          <h2>
            Every journey.
            <br />
            <em>Its own purpose.</em>
          </h2>
        </div>
        <p class="pci-lead">
          Distinct campaigns, each with its own beneficiary, contribution route and reconciliation record.
        </p>
      </div>
    </div>
    <div class="pci-duo">
      <article class="pci-duo__panel pci-duo__panel--education" data-cursor="Explore">
        <div class="pci-duo__media" aria-hidden="true">
          <ScenePicture scene="02" />
        </div>
        <div class="pci-duo__body">
          <span class="pci-status">{walk.label}</span>
          <h3>Walk for Education</h3>
          <p>
            The Nairobi-to-Kagando campaign supporting UCU–Kagando University College and the neighbouring nursery and
            primary school.
          </p>
          <a class="pci-text-link" href="walk-for-education/index.html" data-protected>
            Explore Walk for Education <Icon name="external" />
          </a>
        </div>
      </article>
      <article class="pci-duo__panel pci-duo__panel--faith" data-cursor="Explore">
        <div class="pci-duo__media" aria-hidden="true">
          <img
            src="assets/faith-in-motion/walk-day-arrival-celebration.jpg"
            width="1080"
            height="608"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="pci-duo__body">
          <span class="pci-status">Journey completed · fundraising continues</span>
          <h3>Faith in Motion</h3>
          <p>
            A completed 400 km journey supporting the completion of St Joseph Catholic Church at Rwembyo, Kisinga,
            Kasese District.
          </p>
          <a class="pci-text-link" href="faith-in-motion/index.html">
            Explore Faith in Motion <Icon name="external" />
          </a>
        </div>
      </article>
    </div>
  </section>
  <section class="pci-section pci-section--crimson pci-band">
    <div class="pci-band__backdrop" aria-hidden="true">
      <ScenePicture scene="19" />
    </div>
    <Rings class="pci-band__rings" />
    <div class="pci-container pci-split">
      <div class="pci-split__aside" data-reveal>
        <span class="pci-eyebrow">07 / Partnerships</span>
        <h2>
          Progress is built <em>together.</em>
        </h2>
      </div>
      <div class="pci-split__main pci-body" data-reveal>
        <p class="pci-statement">
          Communities, institutions, businesses and technical partners each have a meaningful role.
        </p>
        <p>
          Bring expertise, networks, practical resources or programme support to a defined community priority. Scope,
          responsibilities and reporting are agreed directly.
        </p>
        <div class="pci-tags">
          <span>Community</span>
          <span>Institutional</span>
          <span>Technical</span>
        </div>
        <div class="pci-actions">
          <a class="pci-button pci-button--light" href="partnerships/index.html">
            Explore Partnerships <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
    <p class="pci-band__caption">Illustration · planning together</p>
  </section>
  <section class="pci-section">
    <div class="pci-container">
      <div class="pci-section-head" data-reveal>
        <div>
          <span class="pci-eyebrow">08 / Selected updates</span>
          <h2>
            The work.
            <br />
            <em>On the record.</em>
          </h2>
        </div>
        <p class="pci-lead">
          Milestones and project reports are published after their sources, figures and permissions have been checked.
        </p>
      </div>
      <UpdatesFeed path="/" />
    </div>
  </section>
  <section class="pci-section pci-section--bone">
    <div class="pci-container">
      <div class="pci-section-head" data-reveal>
        <div>
          <span class="pci-eyebrow">09 / Governance & trust</span>
          <h2>
            Trust is built through <em>clear responsibility.</em>
          </h2>
        </div>
      </div>
      <ul class="pci-trust-points" data-reveal-group>
        <li>
          <b>Beneficiary first.</b>Approved beneficiaries and contribution pathways must be identified.
        </li>
        <li>
          <b>Verification before publication.</b>Received funds and pledges remain distinct.
        </li>
        <li>
          <b>Accountability throughout.</b>Project scope, responsibilities and public information follow documented
          approval.
        </li>
      </ul>
      <a class="pci-text-link" href="governance/index.html">
        Read Our Governance Framework <Icon name="external" />
      </a>
    </div>
  </section>
</Layout>
