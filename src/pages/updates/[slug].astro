---
import Icon from "../../components/global/Icon.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/InstitutionalLayout.astro";
import PageHero from "../../components/global/PageHero.astro";
import { href } from "../../config/site";
export async function getStaticPaths() {
  return (await getCollection("updates", (entry) => entry.data.publication === "approved")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"updates">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = "/updates/" + entry.id + "/";
---

<Layout {path} title={entry.data.title} description={entry.data.summary}>
  <PageHero
    {path}
    label={entry.data.category + " · " + entry.data.date}
    heading={entry.data.title}
    description={entry.data.summary}
  />
  <section class="pci-section">
    <div class="pci-container pci-article">
      <Content />
      <div class="pci-actions">
        <a class="pci-text-link" href={href(path, "/updates/")}>
          All Updates <Icon name="external" />
        </a>
        {entry.data.project && (
          <a class="pci-text-link" href={href(path, entry.data.project)}>
            Related Project <Icon name="external" />
          </a>
        )}
      </div>
    </div>
  </section>
</Layout>
