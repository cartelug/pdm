---
import Layout from "../layouts/InstitutionalLayout.astro";
import PageHero from "../components/global/PageHero.astro";
import SectionHead from "../components/global/SectionHead.astro";
import Rows from "../components/global/Rows.astro";
import Notice from "../components/global/Notice.astro";
import Checks from "../components/global/Checks.astro";
import Icon from "../components/global/Icon.astro";
import Rings from "../components/global/Rings.astro";
import { getPage } from "../lib/pages";
import { href } from "../config/site";
const p = await getPage("partnerships");
const path = "/partnerships/";
---

<Layout {path} title={p.title} description={p.description}>
  <PageHero {path} label={p.title} heading={p.heading} description={p.description} />
  <section class="pci-section">
    <div class="pci-container pci-split pci-split--sticky">
      <div class="pci-split__aside" data-reveal>
        <span class="pci-eyebrow">The approach</span>
        <h2>Structured, not ad hoc.</h2>
      </div>
      <div class="pci-split__main pci-body" data-reveal>
        <p class="pci-lead">
          Pamodzi begins with local priorities and resources, then builds the relationships, technical support and
          appropriate funding route needed for a defined development initiative.
        </p>
        <p>
          These partnerships leverage local knowledge, community ownership, innovation and professional expertise to
          develop scalable solutions aligned with Uganda’s national development priorities and the Sustainable
          Development Goals.
        </p>
        <blockquote class="pci-quote" style="margin-top:clamp(32px,4vw,56px)">
          We are committed to transparent, accountable and mutually beneficial partnerships founded on trust, shared
          responsibility and measurable impact.
        </blockquote>
      </div>
    </div>
  </section>
  <section class="pci-section pci-section--bone">
    <div class="pci-container">
      <SectionHead eyebrow="Our partnership ecosystem">Four routes into the work.</SectionHead>
      <Rows
        {path}
        items={[
          {
            title: "Government institutions and agencies",
            text: "We welcome dialogue with public institutions and local governments where a community-led initiative needs policy alignment, technical guidance or coordination with public services.",
            tags: ["Policy alignment", "Public service delivery", "Technical guidance", "Local planning"],
          },
          {
            title: "Development and financing partners",
            text: "Potential collaboration with development agencies, financial institutions and philanthropic organisations can bring technical expertise, programme funding and responsible financial support.",
            tags: [
              "Sustainable infrastructure",
              "Climate-resilient investment",
              "Enterprise development",
              "Financial inclusion",
              "Institutional strengthening",
            ],
          },
          {
            title: "Private sector and civil society",
            text: "We welcome businesses, professional associations, civil society, faith-based organisations, academic institutions and research bodies that can contribute knowledge, networks, practical support or programme resources.",
            tags: [
              "Corporate social investment",
              "Technical expertise",
              "Innovation solutions",
              "Community engagement",
              "Knowledge & research",
            ],
          },
          {
            title: "Community and local development partners",
            text: "At the centre of the model are communities themselves. The work starts with existing local structures so that people identify priorities, mobilise resources and take part in decisions.",
            tags: [
              "Savings groups",
              "Cooperatives",
              "Investment groups",
              "Alumni associations",
              "Faith-based groups",
              "Community & Service Clubs",
              "Professional networks",
              "CBOs",
            ],
          },
        ]}
      />
    </div>
  </section>
  <section class="pci-section pci-section--night">
    <div class="pci-container pci-split">
      <div class="pci-split__aside" data-reveal>
        <span class="pci-eyebrow">Organisational support</span>
        <h2>Help strengthen the foundation.</h2>
        <p class="pci-lead">
          We welcome conversations with grantmakers, businesses, philanthropists and development partners interested in
          strengthening Pamodzi’s organisational capacity and community programmes.
        </p>
      </div>
      <div class="pci-split__main pci-body" data-reveal>
        <p>
          The right route depends on the purpose of the support, the parties involved and the documentation required.
          Those details are agreed directly before any commitment is made.
        </p>
        <Notice lead="Clear terms for every route.">
          Grants, donations, sponsorships, membership contributions and any commercial investment are separate. No
          investment or financial terms are offered on this website.
        </Notice>
        <div class="pci-figs" style="margin-top:clamp(32px,4vw,56px)">
          <div class="pci-fig">
            <b>Grants</b>
            <span>Programme and capacity support</span>
          </div>
          <div class="pci-fig">
            <b>Sponsorship</b>
            <span>Support for a defined activity or campaign</span>
          </div>
          <div class="pci-fig">
            <b>Partnership</b>
            <span>Expertise, networks and shared delivery</span>
          </div>
        </div>
        <div class="pci-actions">
          <a class="pci-button pci-button--light" href={href(path, "/contact/")}>
            Request the details <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="pci-section">
    <div class="pci-container pci-split pci-split--sticky">
      <div class="pci-split__aside" data-reveal>
        <span class="pci-eyebrow">Walking for Impact</span>
        <h2>Turning participation into financing.</h2>
      </div>
      <div class="pci-split__main pci-body" data-reveal>
        <p class="pci-lead">
          Walking for Impact is a campaign model designed to connect public participation to a defined, independently
          authorised community project.
        </p>
        <p>
          Faith in Motion and Walk for Education are separate campaigns. Each has its own beneficiary, source documents,
          contribution route and reconciliation record.
        </p>
        <Checks
          items={[
            { mark: "01", title: "A champion walks", text: "A designated journey for a defined cause." },
            { mark: "02", title: "Each step carries a value", text: "The journey becomes a measurable target." },
            {
              mark: "03",
              title: "Supporters sponsor steps",
              text: "Individuals, families, businesses and institutions.",
            },
            {
              mark: "04",
              title: "Funds reach the project",
              text: "Linked directly to the identified development need.",
            },
          ]}
        />
        <div class="pci-actions">
          <a class="pci-button pci-button--ink" href={href(path, "/faith-in-motion/")}>
            See Faith in Motion <Icon name="arrow" />
          </a>
          <a class="pci-button pci-button--line" href={href(path, "/walk-for-education/partners/")}>
            Walk for Education partnerships <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="pci-section pci-section--crimson pci-band">
    <Rings class="pci-band__rings" />
    <div class="pci-container">
      <SectionHead
        eyebrow="Start a conversation"
        lede="Whether you represent a ministry, a fund, a business, a congregation or a savings group — there is a route in, and it starts with a message."
      >
        Tell us where
        <br />
        <em>you fit.</em>
      </SectionHead>
      <div class="pci-actions" style="margin-top:0" data-reveal>
        <a class="pci-button pci-button--light" href={href(path, "/contact/")}>
          Get in touch <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
</Layout>
