---
import { getCollection, type CollectionEntry } from "astro:content";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import Layout from "../layouts/InstitutionalLayout.astro";
import PageHero from "../components/global/PageHero.astro";
import ModelPreview from "../components/home/ModelPreview.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import ContactForm from "../components/global/ContactForm.astro";
import UpdatesFeed from "../components/global/UpdatesFeed.astro";
import ProjectStatus from "../components/projects/ProjectStatus.astro";
import { asset, site } from "../config/site";
export async function getStaticPaths() {
  return (await getCollection("pages", (p) => p.data.publication !== "draft")).map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}
interface Props {
  page: CollectionEntry<"pages">;
}
const { page } = Astro.props;
const path = "/" + page.id + "/";
const p = page.data;
const legacyProjectScript =
  asset(path, "js/pdm.js") + "?v=" + createHash("sha256").update(readFileSync("js/pdm.js")).digest("hex").slice(0, 10);
const projects = await getCollection("projects", (p) => p.data.publication !== "draft");
const projectRecord = projects.find((project) => project.id === page.id);
let content = p.html;
if (projectRecord) content = content.replace(/(<b>)UNDER REVIEW(<\/b>)/g, "$1" + projectRecord.data.status + "$2");
if (page.id === "model") content = content.replace(/<section class="blk on-dark">[\s\S]*?<\/section>/, "");
content = content.replace(/class="form"/g, 'class="pci-form"').replace(/class="frow"/g, 'class="pci-form__row"');
---

<Layout {path} title={p.title} description={p.description}>
  <PageHero {path} label={p.title} heading={p.heading} description={p.description} />
  {projectRecord && (
    <div class="pci-container pci-detail-meta">
      <ProjectStatus status={projectRecord.data.status} />
      <span>{projectRecord.data.category}</span>
      <span>{projectRecord.data.location}</span>
    </div>
  )}
  {page.id === "projects" ? (
    <>
      <section class="pci-section">
        <div class="pci-container">
          <div class="pci-filter-bar" aria-label="Filter projects">
            {[
              ["all", "All projects"],
              ["Live campaign", "Live campaigns"],
              ["Under review", "Under review"],
              ["Pipeline", "Pipeline"],
              ["Programme area", "Programme areas"],
              ["Preparing launch", "Preparing launch"],
            ].map(([value, label], i) => (
              <button type="button" data-project-filter={value} aria-pressed={i === 0 ? "true" : "false"}>
                {label}
              </button>
            ))}
          </div>
          <p class="pci-filter-count" role="status" aria-live="polite" data-filter-count>
            {projects.length} projects shown
          </p>
          <div class="pci-project-grid">
            {projects.map((project) => (
              <ProjectCard {project} {path} />
            ))}
          </div>
        </div>
      </section>
      <section class="pci-section pci-muted">
        <div class="pci-container">
          <span class="pci-eyebrow">How a project opens</span>
          <h2>
            Verified first.
            <br />
            <em>Reported until finished.</em>
          </h2>
          <ul class="pci-trust-points">
            <li>
              <b>Define and verify.</b>Confirm the beneficiary, scope, authorised account and approvals in writing.
            </li>
            <li>
              <b>Open a clear pathway.</b>Publish the approved status, contact route and reporting responsibilities.
            </li>
            <li>
              <b>Keep the record connected.</b>Report verified progress and distinguish received support from
              commitments.
            </li>
          </ul>
          <a class="pci-text-link" href="../contact/index.html#enquiry">
            Propose a Community Project ↗
          </a>
        </div>
      </section>
    </>
  ) : page.id === "contact" ? (
    <section class="pci-section">
      <div class="pci-container pci-contact-grid">
        <div>
          <span class="pci-eyebrow">Start a conversation</span>
          <h2>
            Tell us where
            <br />
            <em>you fit.</em>
          </h2>
          <ul class="pci-contact-options">
            <li>
              <small>Email</small>
              <a href={"mailto:" + site.email}>{site.email} ↗</a>
            </li>
            <li>
              <small>WhatsApp</small>
              <a href={site.whatsapp} target="_blank" rel="noopener noreferrer">
                {site.phone} ↗
              </a>
            </li>
            <li>
              <small>Campaign enquiries</small>
              <a href="../faith-in-motion/index.html">Faith in Motion ↗</a>
              <br />
              <a href="../walk-for-education/take-part/index.html">Walk for Education ↗</a>
            </li>
          </ul>
          <p>
            For contribution questions, use the relevant campaign’s approved contact route and verify the beneficiary
            before sending. General enquiry contacts are not payment channels.
          </p>
          <div class="pci-actions">
            <a class="pci-text-link" href="../governance/index.html">
              Governance & Verification ↗
            </a>
          </div>
        </div>
        <ContactForm {path} />
      </div>
    </section>
  ) : page.id === "updates" ? (
    <section class="pci-section">
      <div class="pci-container">
        <span class="pci-eyebrow">Publication record</span>
        <h2>
          Stories with
          <br />
          <em>a source behind them.</em>
        </h2>
        <UpdatesFeed {path} limit={100} />
        <p style="margin-top:32px">
          Received funds, pledges and promises describe different states and are reported separately.
        </p>
      </div>
    </section>
  ) : (
    <>
      <div class:list={["pci-content", "pci-content--" + page.id]} set:html={content} />
      {page.id === "model" && <ModelPreview {path} full />}
    </>
  )}
  {page.id === "apartments" && <script is:inline src={legacyProjectScript} defer />}
</Layout>
