---
import Layout from "../layouts/InstitutionalLayout.astro";
import PageHero from "../components/global/PageHero.astro";
import SectionHead from "../components/global/SectionHead.astro";
import ModelPreview from "../components/home/ModelPreview.astro";
import Notice from "../components/global/Notice.astro";
import Checks from "../components/global/Checks.astro";
import Icon from "../components/global/Icon.astro";
import { getPage } from "../lib/pages";
import { href } from "../config/site";
const p = await getPage("model");
const path = "/model/";
const principles = [
  "Community ownership & local leadership",
  "Domestic resource mobilisation",
  "Strategic partnerships & collective action",
  "Institutional governance & accountability",
  "Sustainable asset development",
  "Inclusive economic growth",
  "Innovation & technology",
  "Climate-responsive investment",
  "Responsible reinvestment",
  "Long-term resilience & prosperity",
];
---

<Layout {path} title={p.title} description={p.description}>
  <PageHero {path} label={p.title} heading={p.heading} description={p.description} />
  <section class="pci-section">
    <div class="pci-container pci-split pci-split--sticky">
      <div class="pci-split__aside" data-reveal>
        <span class="pci-eyebrow">The idea</span>
        <h2>Rather than wait for donors, organise what is already here.</h2>
      </div>
      <div class="pci-split__main pci-body" data-reveal>
        <p class="pci-lead">
          Pamodzi acts as a convener and catalyst — bringing together individuals, community groups, professional
          networks, public institutions, businesses and development partners around a locally chosen priority.
        </p>
        <p>
          The model rests on a simple belief: lasting development happens when communities can mobilise their own
          resources, build strategic partnerships and take collective responsibility for the solution. Pamodzi helps
          organise that participation and identify the governance, technical expertise and institutional support the
          work requires.
        </p>
        <p>
          The approach starts with structures that already exist — savings groups, cooperatives, alumni associations,
          faith-based organisations, business associations and professional networks — then identifies where public,
          technical or financial support is appropriate.
        </p>
        <blockquote class="pci-quote" style="margin-top:clamp(32px,4vw,56px)">
          Pamodzi is not simply interested in projects — it is interested in communities strengthening their ability to
          act together.
        </blockquote>
      </div>
    </div>
  </section>
  <ModelPreview {path} full />
  <section class="pci-section pci-section--bone">
    <div class="pci-container pci-split pci-split--sticky">
      <div class="pci-split__aside" data-reveal>
        <span class="pci-eyebrow">Beyond community projects</span>
        <h2>Shared resources with clear governance.</h2>
      </div>
      <div class="pci-split__main pci-body" data-reveal>
        <p class="pci-lead">
          Where appropriate, the model can help members organise pooled resources around a defined purpose, with
          documented responsibilities, professional advice and a clear separation between community support and any
          commercial activity.
        </p>
        <p>
          The purpose is to strengthen the community’s ability to plan for education, health, agriculture, renewable
          energy, housing and enterprise needs without presenting an unreviewed financial offer.
        </p>
        <Notice lead="Governance first.">
          Central to the model is a framework built on transparency, accountability, professional management and
          responsible stewardship of collective resources. This safeguards community assets and builds the confidence
          partners need.
        </Notice>
        <div class="pci-figs" style="margin-top:clamp(32px,4vw,56px)">
          <div class="pci-fig">
            <b>Local</b>
            <span>Resources identified close to the priority</span>
          </div>
          <div class="pci-fig">
            <b>Collective</b>
            <span>Responsibilities shared and documented</span>
          </div>
          <div class="pci-fig">
            <b>Accountable</b>
            <span>Progress and decisions reported clearly</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="pci-section">
    <div class="pci-container pci-split pci-split--sticky">
      <div class="pci-split__aside" data-reveal>
        <span class="pci-eyebrow">Resource mobilisation</span>
        <h2>How the work gets resourced.</h2>
      </div>
      <div class="pci-split__main pci-body" data-reveal>
        <p class="pci-lead">
          Pamodzi combines several complementary routes rather than depending on one — community campaigns like Walking
          for Impact, strategic and institutional partnerships, and disciplined reinvestment of income the model itself
          generates.
        </p>
        <p>
          Where resources are deployed into productive assets, the priority sectors are chosen for their capacity to
          generate long-term value and fund further community work — not as investment offers made on this website.
          Terms for any organisational or founding support are agreed directly, case by case.
        </p>
        <Checks
          items={[
            {
              title: "Sustainable real estate & infrastructure",
              text: "Community and commercial assets built to last.",
            },
            { title: "Hospitality & tourism development", text: "Regional ventures with local employment." },
            { title: "Agriculture & enterprise", text: "Value-chain and technology-driven solutions." },
            { title: "Regional partnerships", text: "Opportunities that extend beyond Uganda." },
          ]}
        />
        <div class="pci-actions">
          <a class="pci-button pci-button--line" href={href(path, "/partnerships/")}>
            See partnership routes <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="pci-section pci-section--rose">
    <div class="pci-container">
      <SectionHead eyebrow="Guiding principles">Ten things the model is anchored on.</SectionHead>
      <ul class="pci-principles" data-reveal-group>
        {principles.map((principle) => (
          <li>{principle}</li>
        ))}
      </ul>
      <div class="pci-actions" data-reveal>
        <a class="pci-button pci-button--ink" href={href(path, "/impact/")}>
          See the model in practice <Icon name="arrow" />
        </a>
        <a class="pci-button pci-button--line" href={href(path, "/partnerships/")}>
          Partnership pathways <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
</Layout>
