---
import Layout from "../layouts/InstitutionalLayout.astro";
import PageHero from "../components/global/PageHero.astro";
import SectionHead from "../components/global/SectionHead.astro";
import Rows from "../components/global/Rows.astro";
import Cards from "../components/global/Cards.astro";
import Icon from "../components/global/Icon.astro";
import { getPage } from "../lib/pages";
import { href } from "../config/site";
const p = await getPage("about");
const path = "/about/";
---

<Layout {path} title={p.title} description={p.description}>
  <PageHero {path} label={p.title} heading={p.heading} description={p.description} />
  <section class="pci-section">
    <div class="pci-container">
      <div class="pci-split pci-split--sticky">
        <div class="pci-split__aside" data-reveal>
          <span class="pci-eyebrow">Who we are</span>
          <h2>A platform built around local initiative.</h2>
        </div>
        <div class="pci-split__main pci-body" data-reveal>
          <p class="pci-lead">
            Pamodzi mobilises relationships, local resources and practical expertise around priorities chosen by
            communities themselves, with programme interests spanning education, health, climate resilience and
            financial inclusion.
          </p>
          <p>
            Our model is designed to connect communities with public institutions, development partners, businesses and
            professional networks when a defined piece of work needs shared effort.
          </p>
          <p>
            What distinguishes the platform is not any single project but the method behind the work: communities
            participate in setting priorities, organising resources and taking responsibility for what follows.
          </p>
        </div>
      </div>
      <div class="pci-figs" data-reveal style="margin-top:clamp(48px,6vw,96px)">
        <div class="pci-fig">
          <b>Community</b>
          <span>Member-led</span>
        </div>
        <div class="pci-fig">
          <b>4</b>
          <span>Strategic pillars</span>
        </div>
        <div class="pci-fig">
          <b>Uganda</b>
          <span>National focus</span>
        </div>
      </div>
    </div>
  </section>
  <section class="pci-section pci-section--bone">
    <div class="pci-container pci-vm" data-reveal-group>
      <div class="pci-vm__panel">
        <span class="pci-eyebrow">Our vision</span>
        <p>
          Communities across Uganda mobilising partnerships, local resources, innovation and practical expertise to
          shape their own sustainable development.
        </p>
      </div>
      <div class="pci-vm__panel pci-vm__panel--dark">
        <span class="pci-eyebrow">Our mission</span>
        <p>
          To catalyse sustainable community transformation by mobilising partnerships, investment, innovation and
          technical expertise to deliver high-impact programmes across Uganda.
        </p>
      </div>
    </div>
  </section>
  <section class="pci-section">
    <div class="pci-container">
      <SectionHead eyebrow="Strategic objectives">What we are committed to.</SectionHead>
      <Rows
        {path}
        items={[
          {
            title: "Quality education infrastructure",
            text: "Improving access to conducive learning environments and modern education facilities.",
          },
          {
            title: "Stronger health systems",
            text: "Modern infrastructure, medical equipment and enhanced service delivery.",
          },
          {
            title: "Climate resilience",
            text: "Renewable energy, environmental conservation and climate-smart agriculture.",
          },
          {
            title: "Expanded financial inclusion",
            text: "Increasing access to finance, investment capital and entrepreneurship opportunities.",
          },
          {
            title: "Institutional capacity and governance",
            text: "Strengthening partnerships to deliver sustainable and measurable development outcomes.",
          },
        ]}
      />
    </div>
  </section>
  <section class="pci-section pci-section--night pci-values">
    <div class="pci-container">
      <SectionHead eyebrow="Core values">The four we are held to.</SectionHead>
      <Cards
        items={[
          {
            label: "Value I",
            title: "Integrity",
            text: "Honesty, transparency and ethical conduct in all our engagements.",
          },
          {
            label: "Value II",
            title: "Excellence",
            text: "Consistently delivering high-quality programmes that create lasting impact.",
          },
          {
            label: "Value III",
            title: "Accountability",
            text: "Responsible stewardship of resources and measurable results for stakeholders.",
          },
          {
            label: "Value IV",
            title: "Collaboration",
            text: "Inclusive partnerships and teamwork to achieve shared development goals.",
          },
        ]}
      />
    </div>
  </section>
  <section class="pci-section pci-section--bone">
    <div class="pci-container">
      <SectionHead eyebrow="Where next">See how the method works.</SectionHead>
      <div class="pci-actions" style="margin-top:0" data-reveal>
        <a class="pci-button" href={href(path, "/model/")}>
          Our development model <Icon name="arrow" />
        </a>
        <a class="pci-button pci-button--line" href={href(path, "/impact/")}>
          What we have built <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
</Layout>
