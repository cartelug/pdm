---
import Layout from "../layouts/InstitutionalLayout.astro";
import PageHero from "../components/global/PageHero.astro";
import SectionHead from "../components/global/SectionHead.astro";
import PillarIcon from "../components/global/PillarIcon.astro";
import Checks from "../components/global/Checks.astro";
import Cards from "../components/global/Cards.astro";
import Icon from "../components/global/Icon.astro";
import { getPage } from "../lib/pages";
import { href } from "../config/site";
const p = await getPage("what-we-do");
const path = "/what-we-do/";
const pillars = [
  {
    id: "education",
    eyebrow: "Pillar I · Education",
    heading: "Mobilising investment for quality education.",
    lede: "We help communities define education priorities, organise local resources and identify the technical or institutional support needed to move the work forward.",
    text: "Projects are designed for community participation in planning and maintenance, with appropriate alignment to education authorities and district priorities.",
    action: { label: "Explore Walk for Education", to: "/walk-for-education/" },
    items: [
      { title: "Schools and classroom blocks", text: "Construction and rehabilitation." },
      { title: "Science and ICT laboratories", text: "Plus libraries and learning resources." },
      { title: "Teachers’ housing and sanitation", text: "The facilities that keep staff in post." },
      {
        title: "Digital learning and teacher capacity",
        text: "Institutional strengthening and public-private partnerships.",
      },
    ],
  },
  {
    id: "health",
    eyebrow: "Pillar II · Health",
    heading: "Resilient, people-centred health systems.",
    lede: "We help communities define health priorities and identify the professional, public and practical support required for safe, relevant initiatives.",
    text: "Health work is designed to align with relevant authorities and qualified providers while keeping local needs and participation at the centre.",
    items: [
      { title: "Health Centre II, III and IV facilities", text: "Hospitals and maternity wards." },
      { title: "Theatres and diagnostic laboratories", text: "Plus staff accommodation." },
      { title: "Equipment and ambulances", text: "Modern medical equipment and transport." },
      { title: "Energy, water and digital health", text: "Renewable systems, WASH and health-worker development." },
    ],
  },
  {
    id: "climate",
    eyebrow: "Pillar III · Climate & green development",
    heading: "Locally led climate solutions.",
    lede: "We support communities to identify climate solutions that protect ecosystems while strengthening sustainable local opportunity.",
    text: "Community participation is the point — partnerships can strengthen conservation, renewable energy and climate-smart development while aligning work to Uganda’s climate and sustainable development commitments.",
    items: [
      { title: "Renewable energy", text: "Solar, mini-hydro and biogas systems." },
      { title: "Climate-smart agriculture", text: "Irrigation and water resource management." },
      { title: "Afforestation and restoration", text: "Landscape restoration and green infrastructure." },
      { title: "Waste management and education", text: "Environmental education in communities." },
    ],
  },
  {
    id: "inclusion",
    eyebrow: "Pillar IV · Financial inclusion & community enterprise",
    heading: "The foundation of the whole model.",
    lede: "We support community-owned financial practices that improve financial capability, encourage entrepreneurship and help members organise resources responsibly.",
    text: "Savings groups, cooperatives and other member structures can create a disciplined foundation for enterprise and shared priorities, subject to the governance and legal requirements that apply.",
    items: [
      { title: "VSLAs, SACCOs and cooperatives", text: "Strengthening existing community structures." },
      { title: "Youth and women’s enterprises", text: "Enterprise development and peer support." },
      {
        title: "Financial literacy and investment readiness",
        text: "Business incubation and digital financial services.",
      },
      { title: "Responsible resource use", text: "Clear governance for long-term community benefit." },
    ],
  },
] as const;
---

<Layout {path} title={p.title} description={p.description}>
  <PageHero {path} label={p.title} heading={p.heading} description={p.description} />
  <nav class="pci-subnav" aria-label="Programme pillars">
    <div class="pci-container">
      <ul>
        {pillars.map((pillar) => (
          <li>
            <a href={"#" + pillar.id}>
              <PillarIcon name={pillar.id} />
              {pillar.id === "climate"
                ? "Climate & green development"
                : pillar.id === "inclusion"
                  ? "Financial inclusion"
                  : pillar.id[0].toUpperCase() + pillar.id.slice(1)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
  {pillars.map((pillar, i) => (
    <section
      class:list={[
        "pci-section",
        "pci-pillar-section",
        "pci-pillar-section--" + pillar.id,
        { "pci-section--bone": i % 2 === 1 },
      ]}
      id={pillar.id}
    >
      <div class="pci-container pci-split pci-split--sticky">
        <div class="pci-split__aside" data-reveal>
          <div class="pci-pillar-mark">
            <PillarIcon name={pillar.id} />
            <span class="pci-eyebrow">{pillar.eyebrow}</span>
          </div>
          <h2>{pillar.heading}</h2>
        </div>
        <div class="pci-split__main pci-body" data-reveal>
          <p class="pci-lead">{pillar.lede}</p>
          <p>{pillar.text}</p>
          <Checks items={[...pillar.items]} />
          {"action" in pillar && (
            <div class="pci-actions">
              <a class="pci-button pci-button--ink" href={href(path, pillar.action.to)}>
                {pillar.action.label} <Icon name="arrow" />
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}
  <section class="pci-section pci-section--night">
    <div class="pci-container">
      <SectionHead eyebrow="Across every pillar">Six commitments that cut across the work.</SectionHead>
      <Cards
        items={[
          {
            label: "01",
            title: "Inclusion",
            text: "Gender equality, youth empowerment and disability inclusion, for meaningful participation and equal opportunity.",
          },
          {
            label: "02",
            title: "Digital transformation",
            text: "Innovation that improves service delivery, efficiency, knowledge sharing and access to opportunity.",
          },
          {
            label: "03",
            title: "Governance",
            text: "Transparency and accountability systems that build institutional effectiveness and public trust.",
          },
          {
            label: "04",
            title: "Research and learning",
            text: "Evidence-based solutions and continuous learning to improve programme impact.",
          },
          {
            label: "05",
            title: "Partnerships",
            text: "Resource mobilisation frameworks that expand investment and collaboration.",
          },
          {
            label: "06",
            title: "Measurement",
            text: "Monitoring, evaluation and impact measurement to track performance and demonstrate results.",
          },
        ]}
      />
      <div class="pci-actions" data-reveal>
        <a class="pci-button pci-button--light" href={href(path, "/partnerships/")}>
          Partner on a pillar <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
</Layout>
