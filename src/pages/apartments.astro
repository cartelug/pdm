---
import Layout from "../layouts/InstitutionalLayout.astro";
---

<Layout
  path="/apartments/"
  title="Explore our projects"
  description="Explore current PCI projects and campaigns."
  noindex
>
  <section class="pci-section">
    <div class="pci-container">
      <h1>Explore our current projects</h1>
      <p>This historical project link has moved out of public promotion.</p>
      <a class="pci-button" href="../projects/">
        View current projects
      </a>
    </div>
  </section>
  <script is:inline>
    location.replace("../projects/");
  </script>
</Layout>
