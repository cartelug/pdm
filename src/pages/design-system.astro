---
import Icon from "../components/global/Icon.astro";
import PillarIcon from "../components/global/PillarIcon.astro";
import Layout from "../layouts/InstitutionalLayout.astro";
import tokens from "../design/tokens.json";

// Everything on this page is read from src/design/tokens.json, so the documentation cannot drift from the system.
const lin = (v: number) => {
  const c = v / 255;
  return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
};
const channels = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
const lum = ([r, g, b]: number[]) => 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
const ratio = (a: number[], b: number[]) => {
  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};

type Brand = keyof typeof tokens.brands;
const brands = Object.keys(tokens.brands) as Brand[];

function resolve(brand: Brand, name: string, over?: number[]): number[] {
  const definition = tokens.brands[brand];
  const colour = definition.colour as Record<string, string>;
  if (colour[name]) return channels(colour[name]);
  if (name === "on-deep-muted" && over) {
    const alpha = definition.alpha["on-deep-muted"] / 100;
    return channels(colour["on-deep"]).map((c, i) => Math.round(c * alpha + over[i] * (1 - alpha)));
  }
  throw new Error(`${brand} has no colour ${name}`);
}

const pairs = (brand: Brand) =>
  tokens.contrast.pairs.map((pair) => {
    const bg = resolve(brand, pair.bg);
    const value = ratio(resolve(brand, pair.fg, bg), bg);
    return { ...pair, value, ok: value >= pair.min };
  });

const typeValue = (key: string) => (tokens.type as Record<string, string>)[key];
const leadingOf = (key: string) => (tokens.leading as Record<string, string>)[key === "lead" ? "lead" : key];
const trackingOf = (key: string) => (tokens.tracking as Record<string, string>)[key];
const typeRoles: [string, string, string][] = [
  ["display", "Display", "MTN Brighter Sans Bold, hero titles only"],
  ["statement", "Statement", "MTN Brighter Sans Bold, one long sentence"],
  ["h1", "Heading 1", "MTN Brighter Sans Bold, one per page"],
  ["h2", "Heading 2", "MTN Brighter Sans Bold, section titles"],
  ["h3", "Heading 3", "MTN Brighter Sans Bold, card and row titles"],
  ["h4", "Heading 4", "MTN Brighter Sans Bold, small titles"],
  ["lead", "Lead", "Sky Text 400, the opening paragraph"],
  ["body", "Body", "Sky Text 400, 62 characters wide"],
  ["small", "Small", "Sky Text 400, secondary text in cards and notes"],
  ["ui", "Interface", "Sky Text 400, form labels and fine print"],
  ["caption", "Label", "MTN Brighter Sans Bold, capitals, 13 px is the floor"],
];
const roleStyle = (key: string) =>
  `font-size:var(--fs-${key});line-height:var(--lh-${key});` +
  (typeof trackingOf(key) === "string" ? `letter-spacing:var(--ls-${key});` : "") +
  (["lead", "body", "small", "ui"].includes(key)
    ? "font-family:var(--font-body);font-weight:400"
    : "font-family:var(--font-head);font-weight:700" +
      (key === "caption" ? ";text-transform:uppercase;letter-spacing:var(--ls-label)" : ""));
---

<Layout
  path="/design-system/"
  title="Design System Review"
  description="Pamodzi design tokens, type, colour, contrast and rules for both brands."
  noindex
>
  <section class="pci-section">
    <div class="pci-container">
      <span class="pci-eyebrow">Design system / version {tokens.version}</span>
      <h1 style="margin-top:24px">
        One system.
        <br />
        <em>Two brands.</em>
      </h1>
      <p class="pci-lead" style="margin-top:30px">
        {tokens.fonts.head.family} for headings, menus, buttons, labels and figures. {tokens.fonts.body.family} for
        paragraphs, forms and small text. No italics. This page is generated from <code>src/design/tokens.json</code>,
        the single source for the institutional site, Walk for Education and Faith in Motion.
      </p>
      <div class="pci-actions">
        <a class="pci-button" href="../contact/index.html">
          Primary action <Icon name="arrow" />
        </a>
        <a class="pci-button pci-button--ink" href="../contact/index.html">
          Ink action <Icon name="arrow" />
        </a>
        <a class="pci-button pci-button--line" href="../contact/index.html">
          Outline action <Icon name="arrow" />
        </a>
        <a class="pci-text-link" href="../projects/index.html">
          Text action <Icon name="external" />
        </a>
      </div>
    </div>
  </section>

  <section class="pci-section pci-section--bone">
    <div class="pci-container">
      <div class="pci-section-head">
        <div>
          <span class="pci-eyebrow">Type scale</span>
          <h2>
            MTN Brighter Sans leads. <em>Sky Text reads.</em>
          </h2>
        </div>
        <p class="pci-lead">
          Two single-weight files designed by Newlyn, self-hosted, 28 KB together. Sky Text reads; its bold is MTN
          Brighter Sans Bold. MTN Brighter Sans carries tabular figures, so money and counts line up. Emphasis is weight
          or colour, never slant.
        </p>
      </div>
      <div class="pci-ds-specimens">
        {typeRoles.map(([key, name, note]) => (
          <div class="pci-ds-specimen">
            <span class="pci-card__label">
              {name} · {note}
            </span>
            <p style={roleStyle(key)}>Every step builds a future.</p>
            <code>
              --fs-{key}: {typeValue(key)}; --lh-{key}: {leadingOf(key)}
            </code>
          </div>
        ))}
        <div class="pci-ds-specimen">
          <span class="pci-card__label">Figure · MTN Brighter Sans Bold, tabular</span>
          <p style="font:700 var(--fs-figure)/1 var(--font-head);font-variant-numeric:tabular-nums">UGX 250,000</p>
          <code>--fs-figure: {tokens.type.figure}</code>
        </div>
      </div>
    </div>
  </section>

  {brands.map((brand) => (
    <section class:list={["pci-section", { "pci-section--bone": brand === "walk" }]}>
      <div class="pci-container" data-brand={brand}>
        <div class="pci-section-head">
          <div>
            <span class="pci-eyebrow">Colour / {tokens.brands[brand].name}</span>
            <h2>
              {brand === "pci" ? (
                <>
                  Warm paper, burgundy ink, <em>one crimson.</em>
                </>
              ) : (
                <>
                  Ivory, navy, <em>gold and cyan.</em>
                </>
              )}
            </h2>
          </div>
          <p class="pci-lead">
            Select a brand with <code>data-brand="{brand}"</code> on the page root. Gold, cyan and sun are fills and
            decoration only; they fail as text on light surfaces.
          </p>
        </div>
        <div class="pci-swatches">
          {Object.entries(tokens.brands[brand].colour).map(([name, hex]) => (
            <article class="pci-swatch">
              <div class="pci-swatch__chip" style={`background:var(--c-${name})`} />
              <h4>{name}</h4>
              <p>
                {hex} · <code>--c-{name}</code>
              </p>
            </article>
          ))}
        </div>
        <div
          class="pci-ds-table-wrap"
          role="region"
          aria-label={`Contrast checks for ${tokens.brands[brand].name}`}
          tabindex="0"
        >
          <table class="pci-ds-table">
            <caption>Contrast, computed with the WCAG 2.2 formula</caption>
            <thead>
              <tr>
                <th scope="col">Foreground on background</th>
                <th scope="col">Ratio</th>
                <th scope="col">Needs</th>
                <th scope="col">Result</th>
              </tr>
            </thead>
            <tbody>
              {pairs(brand).map((pair) => (
                <tr>
                  <th scope="row">
                    <span
                      class="pci-ds-pair"
                      style={`background:var(--c-${pair.bg === "deep" ? "deep" : pair.bg});color:${pair.fg === "on-deep-muted" ? "var(--c-on-deep-muted)" : `var(--c-${pair.fg})`}`}
                    >
                      Aa
                    </span>
                    {pair.fg} on {pair.bg}
                  </th>
                  <td>{pair.value.toFixed(2)}</td>
                  <td>{pair.min}:1</td>
                  <td>{pair.ok ? "Pass" : "Fail"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}

  <section class="pci-section pci-section--bone">
    <div class="pci-container">
      <div class="pci-section-head">
        <div>
          <span class="pci-eyebrow">Space, shape, motion</span>
          <h2>
            A few values, <em>used everywhere.</em>
          </h2>
        </div>
        <p class="pci-lead">
          Three breakpoints only: {tokens.breakpoints.sm}, {tokens.breakpoints.md} and {tokens.breakpoints.lg} px,
          always min-width. Layout is mobile first. Touch targets are 44 px; nothing is smaller than 24 px.
        </p>
      </div>
      <div class="pci-ds-grid">
        <article class="pci-card">
          <span class="pci-card__label">Space (4 px scale)</span>
          <p class="pci-ds-bars">
            {Object.entries(tokens.space).map(([name, px]) => (
              <span title={`--s-${name}: ${px}px`} style={`width:${px}px`} />
            ))}
          </p>
          <code>{Object.values(tokens.space).join(", ")} px</code>
        </article>
        <article class="pci-card">
          <span class="pci-card__label">Radius</span>
          <p class="pci-ds-radii">
            {Object.entries(tokens.radius).map(([name, value]) => (
              <span title={`--r-${name}: ${value}`} style={`border-radius:${value}`}>
                {name}
              </span>
            ))}
          </p>
        </article>
        <article class="pci-card">
          <span class="pci-card__label">Motion</span>
          <p>
            {Object.entries(tokens.motion.duration)
              .map(([name, ms]) => `${name} ${ms}`)
              .join(" · ")}
          </p>
          <code>ease-out {tokens.motion.ease.out}</code>
        </article>
        <article class="pci-card">
          <span class="pci-card__label">Layers</span>
          <p>
            {Object.entries(tokens.layers)
              .map(([name, z]) => `${name} ${z}`)
              .join(" · ")}
          </p>
          <code>
            shell {tokens.layout.shell}, gutter {tokens.layout.gutter}
          </code>
        </article>
      </div>
    </div>
  </section>

  <section class="pci-section">
    <div class="pci-container">
      <div class="pci-section-head">
        <div>
          <span class="pci-eyebrow">Rules the build enforces</span>
          <h2>
            What every page <em>must do.</em>
          </h2>
        </div>
      </div>
      <ul class="pci-trust-points">
        <li>
          <b>Contrast from tokens.</b>Every pair above is a test. A change that breaks one fails the build.
        </li>
        <li>
          <b>Fonts.</b>MTN Brighter Sans and Sky Text only, self-hosted, no italics, no third-party font host on public
          pages.
        </li>
        <li>
          <b>Responsive.</b>320 px to 1536 px, landscape and 200% text, with no sideways scroll and nothing under 13 px.
        </li>
        <li>
          <b>Honest state.</b>A figure is a target, pledged or verified. A date that is not confirmed is never shown.
        </li>
        <li>
          <b>One fact, one home.</b>Campaign facts are read from the campaign record; a build check fails on any page
          that disagrees.
        </li>
      </ul>
    </div>
  </section>

  <section class="pci-section pci-section--night">
    <div class="pci-container">
      <div class="pci-section-head">
        <div>
          <span class="pci-eyebrow">Programme icons</span>
          <h2>
            One line weight, <em>four pillars.</em>
          </h2>
        </div>
      </div>
      <div class="pci-icon-set">
        {(["education", "health", "climate", "inclusion"] as const).map((name) => (
          <div>
            <PillarIcon {name} />
            <span>{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
