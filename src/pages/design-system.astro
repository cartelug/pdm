---
import Icon from "../components/global/Icon.astro";
import Layout from "../layouts/InstitutionalLayout.astro";
---

<Layout
  path="/design-system/"
  title="Design System Review"
  description="Pamodzi crimson typography, colour and component review."
  noindex
>
  <section class="pci-section">
    <div class="pci-container">
      <span class="pci-eyebrow">Crimson / Foundation review</span>
      <h1>
        People. Partnerships.
        <br />
        <em>Lasting change.</em>
      </h1>
      <p class="pci-lead" style="margin-top:30px">
        Sora Variable for display. Manrope Variable for reading and interfaces.
      </p>
      <div class="pci-actions">
        <a class="pci-button pci-button--gold" href="../contact/index.html">
          Primary action <Icon name="arrow" />
        </a>
        <a class="pci-text-link" href="../projects/index.html">
          Secondary action <Icon name="external" />
        </a>
      </div>
      <div class="pci-evidence-grid">
        {[
          ["Burgundy Ink", "#26090F"],
          ["Warm Paper", "#FBF8F5"],
          ["Soft Blush", "#F3EBE8"],
          ["Crimson", "#B71935"],
          ["Deep Crimson", "#9B1630"],
          ["Light Blush", "#F3C9C8"],
        ].map(([name, colour]) => (
          <article class="pci-evidence">
            <div style={"height:100px;background:" + colour + ";border:1px solid #9b1630"}></div>
            <h3 style="margin-top:18px">{name}</h3>
            <p>{colour}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
