---
import Layout from "../layouts/InstitutionalLayout.astro";
import PageHero from "../components/global/PageHero.astro";
import SectionHead from "../components/global/SectionHead.astro";
import Cards from "../components/global/Cards.astro";
import Steps from "../components/global/Steps.astro";
import Notice from "../components/global/Notice.astro";
import Icon from "../components/global/Icon.astro";
import { getPage } from "../lib/pages";
import { href } from "../config/site";
const p = await getPage("governance");
const path = "/governance/";
---

<Layout {path} title={p.title} description={p.description}>
  <PageHero {path} label={p.title} heading={p.heading} description={p.description} />
  <section class="pci-section">
    <div class="pci-container">
      <SectionHead
        eyebrow="The rules"
        lede="The same rules govern every project that opens under Pamodzi — not as a promise, but as how the system is built."
      >
        Five that never bend.
      </SectionHead>
      <Cards
        items={[
          {
            label: "Rule 01",
            title: "Beneficiary first",
            text: "Every contribution pathway must identify the approved beneficiary and transfer instructions. A campaign page or message alone never authorises a payment.",
          },
          {
            label: "Rule 02",
            title: "Only reconciled figures",
            text: "No total is published until it has been checked against the relevant source records. Nothing is shown as received until it is verified.",
          },
          {
            label: "Rule 03",
            title: "No guaranteed outcomes",
            text: "We never promise a fundraising result or an investment return. The system exists to remove friction and build trust, not to make predictions.",
          },
          {
            label: "Rule 04",
            title: "Approval before publication",
            text: "Money figures, beneficiary details and named individuals require review and permission before anything becomes public.",
          },
          {
            label: "Rule 05",
            title: "Verify every channel",
            text: "When payment details are not published, contributors request the current approved instructions and verify the beneficiary before sending.",
          },
        ]}
      />
    </div>
  </section>
  <section class="pci-section pci-section--night">
    <div class="pci-container">
      <SectionHead
        eyebrow="Follow the money"
        lede="Every contribution takes the same path, and contributions never pass through the campaign team at any point."
      >
        From a supporter to a finished building.
      </SectionHead>
      <Steps
        steps={[
          "A supporter gives",
          "Through a verified channel",
          "Direct to the authorised account",
          "Recorded against the contributor",
          "Reconciled against source records",
          "Published as a confirmed total",
          "Spent on the approved works",
          "Reported until finished",
        ]}
      />
    </div>
  </section>
  <section class="pci-section pci-section--bone">
    <div class="pci-container pci-split pci-split--sticky">
      <div class="pci-split__aside" data-reveal>
        <span class="pci-eyebrow">Communication separation</span>
        <h2>Different things, kept different.</h2>
      </div>
      <div class="pci-split__main pci-body" data-reveal>
        <p class="pci-lead">
          Community development work and investment activity are not the same transaction, and we never present them as
          though they were.
        </p>
        <p>
          Grants, donations, sponsorships, membership contributions and any commercial arrangement are distinct and
          require their own documentation. No investment or financial terms are offered on this website; any future
          offer would require separate legal, financial and governance review.
        </p>
        <Notice lead="Anti-fraud.">
          If a project page does not publish payment details, do not treat a number or account received elsewhere as
          approved. Request the current instructions through the listed enquiry contact and verify the beneficiary
          before sending.
        </Notice>
        <div class="pci-actions">
          <a class="pci-button pci-button--ink" href={href(path, "/contact/")}>
            Report a concern <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
